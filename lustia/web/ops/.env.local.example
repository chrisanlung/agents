# Copy this file to .env.local and fill in values for local development.
# .env.local is gitignored — never commit real secrets.

# Displayed in the header
NEXT_PUBLIC_APP_NAME="Lustia Operations"

# Server-only: base URL for the auth service backend (no trailing slash)
# This variable is NEVER exposed to the browser (no NEXT_PUBLIC_ prefix).
AUTH_API_URL=http://localhost:8080/api/v1
