# UAT environment template — paste these values into Vercel dashboard
# (Project → Settings → Environment Variables) for the lustia-platform project.
#
# AUTH_API_URL is server-only (no NEXT_PUBLIC_ prefix). Next.js server reads it
# from Server Components / Server Actions; the browser never calls the backend
# directly. Therefore HTTP backend on UAT is OK — no mixed-content blocking.

NEXT_PUBLIC_APP_NAME="Lustia Platform Console (UAT)"
AUTH_API_URL=http://43.129.55.236:8080/api/v1
