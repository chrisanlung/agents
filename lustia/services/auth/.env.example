# Auth Service — environment variable reference
# Copy to .env.local for local development. Never commit real secrets.

# Gin mode: debug | release | test
GIN_MODE=debug

# HTTP server port
HTTP_PORT=8080

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# PostgreSQL connection (connect as lustia_app — RLS enforced)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lustia
DB_USER=lustia_app
DB_PASSWORD=changeme

# Path to the PEM-encoded RSA private key used to sign JWTs (RS256).
# Leave empty in local dev to auto-generate an ephemeral key (JWTs will not
# survive a process restart — not suitable for production).
JWT_PRIVATE_KEY_PATH=

# Config file path (consumed by common-configs/config)
CONFIG_PATH=config/app.yaml

# Bootstrap super admin credentials (read by migration seed only — not by service)
# SUPER_ADMIN_EMAIL=superadmin@lustia.internal
# SUPER_ADMIN_PASSWORD_HASH=<argon2id hash — see ADR 0003>

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3 — REQUIRED in release mode (service fails to start without these)
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the tenant-admin portal login page. Baked into the welcome
# email sent to newly-approved tenant admins — an incorrect value means
# temporary credentials are delivered to a URL that does not belong to the
# platform (SECURITY.md Phase 3 H-1).
TENANT_ADMIN_LOGIN_URL=http://localhost:3002/login

# Public URL base for password-reset links emailed to users. The reset token
# is appended as ?token=... when the email is sent.
PASSWORD_RESET_URL_BASE=http://localhost:3000/auth/reset

# Display name used as the friendly-from in emails and as app branding.
APP_DISPLAY_NAME=Lustia

# SMTP (email delivery) — Mailpit for local dev, real provider in staging/prod.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lustia <no-reply@lustia.local>
SMTP_STARTTLS=false
SMTP_TIMEOUT_MS=5000

# CORS allowed origins (comma-separated exact origins; leave empty to disable).
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4 — Storage (ADR 0011)
# STORAGE_DRIVER is required with no default — the service fails fast if unset.
# ─────────────────────────────────────────────────────────────────────────────

# Storage backend: local | r2 | supabase
# - local: writes files to STORAGE_LOCAL_PATH on disk; serves them at
#          GET /uploads/* via the auth-service (dev only).
# - r2:    Cloudflare R2 (S3-compatible). Requires STORAGE_R2_* vars below.
# - supabase: Supabase Storage. Requires STORAGE_SUPABASE_* vars below.
# No default — the service exits on startup if this is blank or unknown.
STORAGE_DRIVER=local

# Absolute path where the local driver writes files.
# Resolved to absolute at startup; service hard-fails if relative or non-writable.
# Ignored when STORAGE_DRIVER != local.
STORAGE_LOCAL_PATH=./storage-data/uploads

# Public URL base for local-driver URL resolution. LocalStorage.URL() returns
# STORAGE_PUBLIC_BASE_URL/<key>. Must match the host/port the service is
# reachable on. Ignored when STORAGE_DRIVER != local.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads

# ── Cloudflare R2 credentials (required when STORAGE_DRIVER=r2) ──────────────
# See OPERATIONS.md §8 — TBD, not yet provisioned.
# Credential must have PutObject + DeleteObject only; no list, no global read.
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=

# ── Supabase Storage credentials (required when STORAGE_DRIVER=supabase) ─────
# See OPERATIONS.md §8 — TBD, not yet provisioned.
# Service key must be scoped to the storage bucket only.
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_SERVICE_KEY=

# ── Upload limits ─────────────────────────────────────────────────────────────
# Hard per-file size cap in megabytes. Enforced before multipart parsing.
UPLOAD_MAX_MB=5

# Max uploads a single tenant may perform in a rolling 60-minute window.
# In-memory sliding window — resets on service restart (Phase 4 acceptable tradeoff).
UPLOAD_TENANT_HOURLY_LIMIT=30

# ─────────────────────────────────────────────────────────────────────────────
# Phase 5 — Booking Engine (ADR 0014)
# ─────────────────────────────────────────────────────────────────────────────

# Application environment. Controls payment adapter selection safety gate.
# Values: dev | local | staging | production
# SECURITY (C-2): When PAYMENT_ADAPTER=dummy, the service will log.Fatal at
# startup if APP_ENV is not "dev" or "local". This prevents an accidental
# dummy adapter reaching staging/production (free paid bookings for attackers).
APP_ENV=dev

# Payment adapter: dummy (dev/local only) | midtrans (when keys available).
# SECURITY (C-2): dummy adapter is hard-blocked outside dev/local environments.
PAYMENT_ADAPTER=dummy

# Midtrans credentials — required when PAYMENT_ADAPTER=midtrans.
# Load from secret manager in production; never commit real keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Midtrans environment: sandbox | production
MIDTRANS_ENVIRONMENT=sandbox
