            "url": "{{host}}/api/v1/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));",
            "pm.test('TOKEN_INVALID', () => pm.expect(pm.response.json().error.code).to.eql('TOKEN_INVALID'));"
          ]}}]
        },
        {
          "name": "Forgot unknown email → still 204 (anti-enum)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"email\": \"ghost@nowhere.example\" }" },
            "url": "{{host}}/api/v1/auth/password/forgot"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 204 regardless', () => pm.response.to.have.status(204));"
          ]}}]
        }
      ]
    }
