		{
			"name": "1 · Auth (public)",
			"item": [
				{
					"name": "POST /auth/login — super-admin",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"if (pm.response.code === 200) {",
								"  const d = pm.response.json();",
								"  pm.collectionVariables.set('super_token', d.access_token);",
								"  pm.collectionVariables.set('super_refresh_token', d.refresh_token);",
								"  console.log('saved super_token');",
								"}"
							]
						}
					}],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{super_email}}\",\n  \"password\": \"{{super_password}}\"\n}" },
						"url": { "raw": "{{api}}/auth/login", "host": ["{{api}}"], "path": ["auth", "login"] }
					}
				},
				{
					"name": "POST /auth/login — tenant-admin",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"if (pm.response.code === 200) {",
								"  const d = pm.response.json();",
								"  pm.collectionVariables.set('tenant_token', d.access_token);",
								"  pm.collectionVariables.set('tenant_refresh_token', d.refresh_token);",
								"  if (d.tenant_id) pm.collectionVariables.set('tenant_id', d.tenant_id);",
								"  console.log('saved tenant_token');",
								"}"
							]
						}
					}],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{tenant_password}}\"\n}" },
						"url": { "raw": "{{api}}/auth/login", "host": ["{{api}}"], "path": ["auth", "login"] }
					}
				},
