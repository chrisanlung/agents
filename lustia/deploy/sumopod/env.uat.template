# Lustia auth-service — UAT environment template.
# Deploy as /opt/lustia/config/.env (chmod 600, owned by lustia:lustia).
# Replace ${...} placeholders before deploying.

# --- App ---
GIN_MODE=release
HTTP_PORT=8080
LOG_LEVEL=info
CONFIG_PATH=/opt/lustia/config/app.yaml
APP_DISPLAY_NAME=Lustia
APP_ENV=uat

# --- Payment (iPaymu sandbox; switch to production credentials when needed) ---
PAYMENT_PROVIDER=ipaymu
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_VA=${IPAYMU_VA}
IPAYMU_API_KEY=${IPAYMU_API_KEY}
# Webhook URL points to this server's public IP (no domain yet).
# After domain + SSL: switch to https://uat-api.lusthing.id/...
IPAYMU_NOTIFY_URL=http://43.129.55.236:8080/api/v1/public/payments/webhook
IPAYMU_SKIP_SIGNATURE_VERIFY=true

# --- Database (Postgres 17 self-installed on this VPS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lustia
DB_USER=lustia_app
DB_PASSWORD=${PG_APP_PASSWORD}

# --- JWT (4096-bit RSA, generate fresh per environment) ---
JWT_PRIVATE_KEY_PATH=/opt/lustia/config/jwt_private.pem
JWT_KID=primary

# --- SMTP — disabled for UAT initially. Flip to true when SMTP creds ready. ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lustia UAT <no-reply@lustia.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_MS=5000
PASSWORD_RESET_URL_BASE=http://43.129.55.236:8080/auth/reset

# --- CORS — Vercel preview / prod URLs go here once frontend deployed. ---
# Comma-separated exact origins. Empty = CORS disabled (UAT testing via curl/Postman OK).
CORS_ALLOWED_ORIGINS=

# --- Storage (ADR 0011) — local FS on this VPS. ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/opt/lustia/storage/uploads
STORAGE_PUBLIC_BASE_URL=http://43.129.55.236:8080/uploads
UPLOAD_MAX_MB=5
UPLOAD_TENANT_HOURLY_LIMIT=30
