# Lustia — local dev stack environment
#
# Copy to .env (same directory) and edit the CHANGE_ME_* values.
# Never commit .env — only this template.
#
#   cp deploy/.env.example deploy/.env

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
# Superuser (owns the cluster, runs init-db/, used by the migrator container).
POSTGRES_USER=lustia_superuser
POSTGRES_PASSWORD=CHANGE_ME_dev_only
POSTGRES_DB=lustia

# Host port to expose Postgres on. 5433 avoids collision with a local
# Postgres running on the default 5432.
POSTGRES_PORT=5433

# Password for the application role (lustia_app) created by
# init-db/01-create-app-role.sh. auth-service connects with this.
LUSTIA_APP_PASSWORD=CHANGE_ME_dev_only

# -----------------------------------------------------------------------------
# auth-service
# -----------------------------------------------------------------------------
# Port the auth HTTP server listens on (inside the container AND on the host).
AUTH_PORT=8080

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Gin mode: debug | release | test
GIN_MODE=debug

# JWT key identifier surfaced in tokens and JWKS. Rotate by incrementing
# (e.g. `primary`, `k2026-04`). Never reuse an old value for a new key.
JWT_KID=primary

# -----------------------------------------------------------------------------
# Bootstrap super admin (consumed per ADR 0003)
# -----------------------------------------------------------------------------
# Default is the local-dev placeholder (admin@lustia.local) — works with
# Mailpit in the compose stack. MUST be replaced with a monitored mailbox
# before any staging/prod deploy (SECURITY.md § 9.4, ADR 0003).
SUPER_ADMIN_EMAIL=admin@lustia.local

# Initial password the operator sets via the post-migration UPDATE.
# Rotate on first login. Never reuse across environments.
SUPER_ADMIN_INITIAL_PASSWORD=CHANGE_ME_rotate_on_first_login

# -----------------------------------------------------------------------------
# Email (Mailpit in dev; real provider in staging/prod)
# -----------------------------------------------------------------------------
# Mailpit web UI is published on the host at MAILPIT_UI_PORT (default 8025).
# Open http://localhost:8025 to view sent emails during development.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Toggle auth-service email dispatch. Set false to have forgot-password
# generate tokens only (no mail sent); useful when debugging.
SMTP_ENABLED=true

# SMTP server the auth-service connects to. In the compose stack, the
# service name `mailpit` resolves over the `lustia` network.
SMTP_HOST=mailpit
SMTP_PORT=1025

# Mailpit accepts any credentials (MP_SMTP_AUTH_ACCEPT_ANY=1), so leave
# these blank in dev. For staging/prod, populate per your provider.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_MS=5000

# Display name used in the "From" header and email templates.
SMTP_FROM=Lustia <no-reply@lustia.local>
APP_DISPLAY_NAME=Lustia

# Base URL for password-reset links — appended with `?token=<raw>`.
# In dev this points at the (future) web frontend running on :3000; the link
# body is still delivered by Mailpit.
PASSWORD_RESET_URL_BASE=http://localhost:3000/auth/reset
