# Root .gitignore — project-wide excludes.
# Per-subproject .gitignore (backend, frontends) still applies as well.

# Claude Code local permission cache (per-machine, may contain secrets)
.claude/settings.json
.claude/settings.local.json

# TypeScript incremental build cache (per-machine)
**/tsconfig.tsbuildinfo

# Git Bash / msys stack dumps
bash.exe.stackdump
*.stackdump

# OS cruft
.DS_Store
Thumbs.db

# Local storage uploads (ADR 0011) — runtime data, never committed.
# Production uses Cloudflare R2 / Supabase Storage.
lustia/services/auth/storage-data/

# Compiled Go binary (rebuilt via `go build`).
lustia/services/auth/bin/
